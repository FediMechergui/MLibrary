{
  "name": "mlibrary",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "catalog:seed": "node scripts/bulk-seed.mjs",
    "deploy": "netlify deploy --build --prod"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/inappbrowser": "^4.1.0",
    "@capacitor/share": "^8.0.3",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/newsreader": "^5.2.0",
    "@fontsource/noto-naskh-arabic": "^5.2.0",
    "@netlify/blobs": "^10.0.0",
    "@phosphor-icons/react": "^2.1.0",
    "csv-parse": "^7.0.3",
    "epubjs": "^0.3.93",
    "idb-keyval": "^6.2.2",
    "linkedom": "^0.18.15",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "^0.9.12"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jszip": "^3.10.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
